FROM node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d AS build
WORKDIR /workspace
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @alem-do-sisu/web exec ng build --configuration=staging

FROM nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de
COPY --from=build /workspace/apps/web/dist/web/browser /usr/share/nginx/html
COPY apps/web/nginx.staging.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
