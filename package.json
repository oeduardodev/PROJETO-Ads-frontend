{
  "name": "alem-do-sisu-frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "lint": "eslint apps/web/src apps/web/e2e",
    "typecheck": "corepack pnpm --filter @alem-do-sisu/web exec ngc -p tsconfig.app.json --noEmit",
    "test": "corepack pnpm --filter @alem-do-sisu/web test",
    "build": "corepack pnpm --filter @alem-do-sisu/web build",
    "test:e2e": "corepack pnpm --filter @alem-do-sisu/web test:e2e",
    "api:generate": "corepack pnpm --filter @alem-do-sisu/web exec openapi-ts -i ../../contracts/public-v1.json -o src/app/core/api/generated && prettier --write \"apps/web/src/app/core/api/generated/**/*.ts\"",
    "format": "prettier --write \"apps/web/src/**/*.{ts,html,css}\" \"apps/web/e2e/**/*.mjs\" apps/web/angular.json apps/web/package.json package.json eslint.config.mjs",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,html,css}\" \"apps/web/e2e/**/*.mjs\" apps/web/angular.json apps/web/package.json package.json eslint.config.mjs"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1"
  }
}
